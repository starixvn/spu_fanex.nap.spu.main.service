<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="HealthChecks\**" />
    <Content Remove="HealthChecks\**" />
    <EmbeddedResource Remove="HealthChecks\**" />
    <None Remove="HealthChecks\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="bundleconfig.json" />
    <Content Remove="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="8.1.1" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Fanex.Data" Version="4.3.4" />
    <PackageReference Include="Fanex.Data.MySql" Version="4.3.4" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.4" />
    <PackageReference Include="Fanex.Logging" Version="2.0.2" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.NAP.SPU.AspNetCore.Notification" Version="1.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="5.0.9" />
    <PackageReference Include="ONEbook.UM.AspNetCore" Version="3.1.0-beta04" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="4.1.1" />
    <PackageReference Include="Quartz" Version="3.3.2" />
    <PackageReference Include="Refit" Version="8.0.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
    <PackageReference Include="SilkierQuartz" Version="5.0.0.4" />
    <PackageReference Include="SilkierQuartz.Plugins.RecentHistory" Version="5.0.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.KLSIMPLE.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.KLPROD.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Views\SchedulerManager\UpdateJob.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\css\libs\chosen\chosen-sprite.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\css\libs\chosen\chosen-sprite@2x.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\Images\collapse.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\Images\expand.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="App_Data\KLDR\" />
    <Folder Include="App_Data\SIT\" />
    <Folder Include="App_Data\PROD\" />
    <Folder Include="App_Data\UAT\" />
    <Folder Include="Features\JobSchedulers\Controllers\" />
    <Folder Include="Features\SchedulerManager\Model\" />
    <Folder Include="wwwroot\css\fonts\" />
    <Folder Include="wwwroot\css\components\" />
    <Folder Include="wwwroot\css\abstracts\" />
    <Folder Include="wwwroot\css\base\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.NAP.SPU.CTS\Fanex.NAP.SPU.CTS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App_Data\KLDR\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\LOCAL\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\PROD\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\SIT\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\UAT\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
