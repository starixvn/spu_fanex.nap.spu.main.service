@using Fanex.NAP.SPU.Main.Features.JobSchedulers.ViewModels;
@model IEnumerable<GroupJob>

@{ ViewData["Title"] = "Updated Jobs"; }

<div class="group-info">
    <input id="btnSaveUpdateJobs" type="button" title="ReSchedule Jobs" value="Update" onclick="if (confirm('Are you sure you want to reschedule all jobs?')) { location.href = '@Url.Action("SaveUpdateJobs", "Scheduler")' } ">
    <input id="btnReload" type="button" value="Reload" onclick="location.href = '@Url.Action("CheckUpdateJobs", "Scheduler")'" />
</div>

<table id="tblJob" class="table-job" cellpadding="2" cellspacing="2">
    <tr class="table-job-tr-header">
        <td width="50" style="text-align:center"></td>
        <td class="table-job-td-header">
            <span>Job Name</span>
        </td>
        <td class="table-job-td-header">
            <span>Job Type</span>
        </td>
        <td class="table-job-td-header">
            <span>APIUrl</span>
        </td>
        <td class="table-job-td-header" style="width:60px">
            <span>IsActive</span>
        </td>
        <td class="table-job-td-header" style="width:60px">
            <span>Status</span>
        </td>
    </tr>

            @if (Model != null && Model.Any())
            {
                foreach (var groupJob in Model)
                {


                    foreach (var job in groupJob.Jobs)
                    {
                            <tr class="table-job-tr-body" style="background-color:#FFFFFF">
                                <td class="td-body">
                                    <span class="toogle-job toogle-collapse" data-job-name=@(job.JobName)></span>
                                </td>
                                <td class="table-job-td-body">
                                    <span>@job.JobName</span>
                                </td>
                                <td class="table-job-td-body">
                                    <span>
                                        @job.JobType
                                    </span>
                                </td>
                                <td class="table-job-td-body">
                                    <span>@job.APIUrl</span>
                                </td>
                                <td class="table-job-td-body">
                                    <span>@job.Active</span>
                                </td>
                                <td class="table-job-td-body">
                                    <span>@(groupJob.ExistingJobs.Any(x=>x.JobId == job.JobId) ? "Existing" : "New")</span>
                                </td>
                            </tr>

                        <tr data-job-name=@(job.JobName) class="is-hidden">
                            <td colspan="5">
                                <table class="table-trigger">
                                    <tr class="table-trigger-tr-header">
                                        <td class="table-trigger-td-header">
                                            <span>Trigger Name</span>
                                        </td>
                                        <td class="table-trigger-td-header">
                                            <span>Trigger Type</span>
                                        </td>
                                        <td class="table-trigger-td-header">
                                            <span>Repeat Forever</span>
                                        </td>
                                        <td class="table-trigger-td-header">
                                            <span>Cron Expression</span>
                                        </td>
                                    </tr>

                                    @foreach (var trigger in job.Triggers)
                                    {
                                        <tr data-job-name=@(job.JobName) class="is-hidden" style="background-color: #FFFFFF">
                                            <td class="table-trigger-td-body">
                                                <span>
                                                    @trigger.TriggerName
                                                </span>
                                            </td>
                                            <td class="table-trigger-td-body">
                                                <span>
                                                    @trigger.TriggerType
                                                </span>
                                            </td>
                                            <td class="table-trigger-td-body">
                                                <span>
                                                    @trigger.RepeatForever
                                                </span>
                                            </td>
                                            <td class="table-trigger-td-body">
                                                <span>
                                                    @trigger.CronExpression
                                                </span>
                                            </td>
                                        </tr>
                                      }

                                </table>
                            </td>
                        </tr>
}
                }}

</table>
