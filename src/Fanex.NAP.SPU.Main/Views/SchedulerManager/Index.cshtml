@using Fanex.NAP.SPU.Main.Features.JobSchedulers.ViewModels;
@model IEnumerable<GroupJob>

@{
    ViewData["Title"] = "Updated Jobs";
}

<div class="group-info">
    @*
    <input id="btnSaveUpdateJobs" type="button" title="ReSchedule Jobs" value="Update" onclick="if (confirm('Are you sure you want to reschedule all jobs?')) { location.href = '@Url.Action("SaveUpdateJobs", "Scheduler")' } ">
    *@
    <br />
    <div>
        <button id="btnRestartSchedulerFromDb" class="btn btn-primary">Restart Scheduler from Database</button>
    </div>
    <br />
    <div class="group width-200">
        <button id="btnLoadJobsUpdateFromDb" class="btn btn-primary">Load Jobs from Database</button>
    </div>
    <br />

    <div class="group width-200">
        <button id="btnUpdateJobsFromDb" class="btn btn-primary">Update Jobs from Database</button>
    </div>

    <br />
    <div class="group width-200">
        <button id="btnUpdateJob" class="btn btn-primary">Update Job from Scheduler</button>
        <input type="text" id="txtUpdateJobName" placeholder="Job Name" />
        <input type="text" id="txtUpdateGroupName" placeholder="Group Name" />
    </div>

    <br />
    <div class="group width-200">
        <button id="btnDeleteJob" class="btn btn-primary">Delete Job from Scheduler</button>
        <input type="text" id="txtDeleteJobName" placeholder="Job Name" />   
        <input type="text" id="txtDeleteGroupName" placeholder="Group Name" />
    </div>

    <br />
    <div class="group width-200">
        <button id="btnDeleteAllJobs" class="btn btn-primary">Delete All Jobs from Scheduler</button>
    </div>

    <br />
    <div class="group width-200">
        <button id="btnUpdateFlagJobUpdate" class="btn btn-primary">Update Flag Job Update</button>
    </div>

    <br />   
    <div>
        <a class="nav-link text-dark" href="/Authenticates/Logout">Logout</a>
    </div>    
</div>


@section Scripts {
    <script src="~/js/SchedulerManager/index.js"></script>
}
