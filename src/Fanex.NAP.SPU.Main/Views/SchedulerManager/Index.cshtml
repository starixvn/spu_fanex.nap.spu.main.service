@using Fanex.NAP.SPU.Main.Features.JobSchedulers.ViewModels;
@model IEnumerable<GroupJob>

@{
    ViewData["Title"] = "Updated Jobs";
}

<div class="page-container">
    <div class="group-info">
        <div>
            <span>
                <a class="text-dark" href="/Authenticates/Logout"><i class="icon-logout"></i> Logout</a>
            </span>
        </div>
             
        <div class="group width-200">
            <button id="btnAddJob" class="btn btn-primary">Add Job</button>

            <button id="btnGetJobsFromDb" class="btn btn-primary">Load Jobs from Db</button>

            <button id="btnRestartSchedulerFromDb" class="btn btn-primary">Restart Scheduler from Db</button>
       
        </div>
    </div>
    @Html.Partial("AddJob")

    <div id="tabsContainer" class="tabs-container">
        <div id="tabsHeader" class="tabs">
        </div>

        <div id="tabsContent">
        </div>

    </div>
</div>

