<div class="popup-overlay">  
    <div class="popup-content">
        <div class="form-group">
            <h1>Add Job</h1>
            <label class="active-job"><input type="checkbox" id="chkActiveJob" value="false"> Active Job</label>
       </div>
        
        <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="txtJobName" placeholder="Name">
        </div>
        <div class="form-group">
            <label for="group">Group *</label>
            <select id="selGroupJob">              
            </select>
        </div>
        <div class="form-group">
            <label>Job Type *</label>
            <select id="selJobType">
                <option>Fanex.NAP.SPU.Main.JobSchedulers.Services.JobExecute</option>
                <option>Fanex.NAP.SPU.Main.Features.JobSchedulers.Services.JobMonitoring</option>
            </select>
        </div>    
        <div class="job-data-map">         
            <div class="form-group">
                <label>API url *</label>
                <input type="text" id="txtApiUrl" placeholder="String">
            </div>
            <div class="form-group">
                <label>Method Name *</label>
                <input type="text" id="txtMethodName" placeholder="String">
            </div>
            <div class="form-group">
                <label>Controller *</label>
                <input type="text" id="txtController" placeholder="String">
            </div>         
        </div>
        
        <h1>Add Trigger</h1>

        <div class="form-group">
            <label>Trigger Name *</label>
            <input type="text" id="txtTriggerName" placeholder="Trigger Name">
        </div>

        <div class="radio-group">
            <label><input type="radio" name="rdTriggerType" value="Cron" checked> Cron</label>
            <label><input type="radio" name="rdTriggerType" value="Simple"> Simple</label>
        </div>

        <div class="cron-trigger-properties">            
            <div class="form-group">
                <label>Cron Expression</label>
                <input type="text" id="txtCronExpression" placeholder="Cron Expression">
            </div>
            <div class="form-group">
                <label>Interval In Second</label>
                <input type="text" id="txtIntervalInSecond" placeholder="Interval In Second">
            </div>          
        </div>      
      
        <div class="buttons">         
            <button id="btnSaveJob" class="primary">Save</button>
            <button id="btnCancelJob" class="second">Cancel</button>
        </div>
    </div>
</div>
