<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fanex.NAP.SPU.Main</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/schedulermannager.css" />     
    <link href="~/css/datatables/dt-2.2.0/datatables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/fonts/style.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Fanex.NAP.SPU.Main</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item active">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" target="_blank" asp-area="" asp-controller="" asp-action="Index">Job Monitoring</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Job API
                            </a>
                            <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="DCSUrl">DCS</a>
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="CTSUrl">CTS</a>
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="CTS_CCUrl">CTS_CC</a>
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="FSUrl">FS</a>
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="VRUrl">VR</a>
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="TGRUrl">TGR</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                External Sites
                            </a>
                            <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <a class="dropdown-item" target="_blank" asp-area="" asp-controller="Home" asp-action="PortainerUrl">Portainer</a>
                                <a class="dropdown-item" target="_blank" href="https://gitlab.nexdev.net/spu">GitLab</a>
                                <a class="dropdown-item" target="_blank" href="https://rocketor.nexdev.net/">Rocketor</a>
                                <a class="dropdown-item" target="_blank" href="https://www.freeformatter.com/">Formatter</a>
                                <a class="dropdown-item" target="_blank" href="https://codebeautify.org/">Code Beautify</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Check Update
                            </a>
                            <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <a class="nav-link text-dark" href="/SchedulerManager/Index">Scheduler Manager</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2021 - Fanex.NAP.SPU.Main - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
